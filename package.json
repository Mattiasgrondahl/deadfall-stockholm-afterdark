{
  "name": "deadfall-stockholm-afterdark",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Deadfall: Stockholm Afterdark - a first-person zombie survival shooter built with Three.js and Vite.",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "node --test",
    "verify": "node tools/verify-game.mjs",
    "graft": "graft",
    "graft-map": "graft map",
    "graft-build": "graft build .",
    "graft-check": "graft check",
    "zg": "ZVEC_GREP_HOME=.zvec-home ZVEC_GREP_DEVICE=cpu zg",
    "zg-index": "ZVEC_GREP_HOME=.zvec-home ZVEC_GREP_DEVICE=cpu zg index --embedding local/potion-code-16m-v2 ."
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@nanonets/graft": "^0.18.0",
    "@zvec/zvec-grep": "^0.2.2",
    "playwright-core": "^1.63.0",
    "vite": "^8.2.2"
  },
  "allowScripts": {
    "@nanonets/graft@0.18.0": true,
    "tree-sitter-javascript@0.23.1": true,
    "tree-sitter-typescript@0.23.2": true,
    "tree-sitter@0.21.1": true,
    "tree-sitter@0.22.4": true,
    "tree-sitter-cli@0.23.2": true,
    "@zvec/zvec-grep@0.2.2": true,
    "@zvec/zvec@0.7.1": true,
    "node-llama-cpp@3.18.1": true,
    "onnxruntime-node@1.21.0": true,
    "sharp@0.34.5": true,
    "protobufjs@7.6.6": true,
    "tree-sitter-swift@0.7.1": true,
    "@davisvaughan/tree-sitter-r@1.3.0": true,
    "tree-sitter-go@0.23.4": true,
    "tree-sitter-java@0.23.5": true,
    "tree-sitter-kotlin@0.3.8": true,
    "tree-sitter-php@0.23.12": true,
    "tree-sitter-python@0.21.0": true
  }
}
